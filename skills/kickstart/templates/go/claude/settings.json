{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(go build)",
      "Bash(go build *)",
      "Bash(go test)",
      "Bash(go test *)",
      "Bash(go vet)",
      "Bash(go vet *)",
      "Bash(go mod tidy)",
      "Bash(go mod tidy *)",
      "Bash(gofmt -l)",
      "Bash(gofmt -l *)",
      "Bash(golangci-lint run)",
      "Bash(golangci-lint run *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
