{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(swift build)",
      "Bash(swift build *)",
      "Bash(swift test)",
      "Bash(swift test *)",
      "Bash(swift package resolve)",
      "Bash(swift package resolve *)",
      "Bash(swift package describe)",
      "Bash(swift package describe *)",
      "Bash(xcodebuild -list)",
      "Bash(xcodebuild -list *)",
      "Bash(swiftformat --lint)",
      "Bash(swiftformat --lint *)",
      "Bash(swiftlint lint)",
      "Bash(swiftlint lint *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
